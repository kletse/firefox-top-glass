#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
REPO_ROOT=$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)
ASSETS_DIR="$REPO_ROOT/assets"

CSS_BEGIN='/* BEGIN firefox-top-glass */'
CSS_END='/* END firefox-top-glass */'
JS_BEGIN='// BEGIN firefox-top-glass'
JS_END='// END firefox-top-glass'
LUA_BEGIN='-- BEGIN firefox-top-glass'
LUA_END='-- END firefox-top-glass'
THEME_MARKER_PREFIX='/* firefox-top-glass theme: '

ACTION=install
ACTION_SET=0
THEME=dark
PROFILE_OVERRIDE=''
FIREFOX_ROOT_OVERRIDE=''
HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
RELOAD_HYPRLAND=1
CHANGED=0
TIMESTAMP=$(date -u +%Y%m%dT%H%M%SZ)
TMP_PATHS=()
CHROME_ASSET=''

usage() {
  cat <<EOF
Usage: $PROGRAM [install|status|remove] [options]

Options:
  --theme NAME        Use a bundled chrome theme (default: dark).
  --profile PATH       Use an explicit Firefox profile directory.
  --firefox-root PATH  Use an explicit Firefox profiles root.
  --hypr-dir PATH      Use an explicit Omarchy Hyprland config directory.
  --no-reload          Do not reload or validate the live Hyprland session.
  -h, --help           Show this help.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

cleanup() {
  local path
  for path in "${TMP_PATHS[@]:-}"; do
    if [[ -n "$path" && -e "$path" ]]; then
      rm -f -- "$path"
    fi
  done
  return 0
}
trap cleanup EXIT

while (($#)); do
  case "$1" in
    install|status|remove)
      ((ACTION_SET == 0)) || die 'specify only one action'
      ACTION=$1
      ACTION_SET=1
      shift
      ;;
    --profile)
      (($# >= 2)) || die '--profile requires a path'
      PROFILE_OVERRIDE=$2
      shift 2
      ;;
    --theme)
      (($# >= 2)) || die '--theme requires a name'
      THEME=$2
      shift 2
      ;;
    --firefox-root)
      (($# >= 2)) || die '--firefox-root requires a path'
      FIREFOX_ROOT_OVERRIDE=$2
      shift 2
      ;;
    --hypr-dir)
      (($# >= 2)) || die '--hypr-dir requires a path'
      HYPR_DIR=$2
      shift 2
      ;;
    --no-reload)
      RELOAD_HYPRLAND=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

for asset in userChrome.css user.js firefox-top-glass.lua hyprland-require.lua; do
  [[ -f "$ASSETS_DIR/$asset" ]] || die "missing repository asset: $ASSETS_DIR/$asset"
done

available_themes() {
  local path=''
  local name=''
  local separator=''

  shopt -s nullglob
  for path in "$ASSETS_DIR"/themes/*.css; do
    name=${path##*/}
    name=${name%.css}
    printf '%s%s' "$separator" "$name"
    separator=', '
  done
  shopt -u nullglob
  printf '\n'
}

[[ "$THEME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid theme name: $THEME"
THEME_ASSET="$ASSETS_DIR/themes/$THEME.css"
if [[ ! -f "$THEME_ASSET" ]]; then
  die "unknown theme '$THEME'; available themes: $(available_themes)"
fi

detect_firefox_root() {
  local candidate

  if [[ -n "$FIREFOX_ROOT_OVERRIDE" ]]; then
    [[ -d "$FIREFOX_ROOT_OVERRIDE" ]] || die "Firefox root not found: $FIREFOX_ROOT_OVERRIDE"
    printf '%s\n' "$FIREFOX_ROOT_OVERRIDE"
    return
  fi

  for candidate in \
    "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox" \
    "$HOME/.mozilla/firefox"; do
    if [[ -f "$candidate/profiles.ini" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  die 'could not find Firefox profiles.ini; use --firefox-root or --profile'
}

resolve_profile_candidate() {
  local root=$1
  local value=$2

  value=${value//$'\r'/}
  if [[ "$value" = /* ]]; then
    printf '%s\n' "$value"
  else
    printf '%s/%s\n' "$root" "$value"
  fi
}

detect_profile() {
  local root=$1
  local value=''
  local candidate=''
  local entry=''
  local relative='1'
  local profile_path=''
  local matches=()

  if [[ -f "$root/installs.ini" ]]; then
    value=$(awk -F= '$1 == "Default" { sub(/^[^=]*=/, ""); print; exit }' "$root/installs.ini")
    if [[ -n "$value" ]]; then
      candidate=$(resolve_profile_candidate "$root" "$value")
      if [[ -d "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return
      fi
    fi
  fi

  if [[ -f "$root/profiles.ini" ]]; then
    entry=$(awk -F= '
      function emit() {
        if (!done && in_profile && is_default == "1" && path != "") {
          print relative "|" path
          done = 1
        }
      }
      /^\[Profile[0-9]+\]\r?$/ {
        emit()
        in_profile = 1
        is_default = 0
        relative = 1
        path = ""
        next
      }
      /^\[/ {
        emit()
        in_profile = 0
        next
      }
      in_profile && $1 == "Default" { is_default = $2; gsub(/\r/, "", is_default) }
      in_profile && $1 == "IsRelative" { relative = $2; gsub(/\r/, "", relative) }
      in_profile && $1 == "Path" {
        sub(/^[^=]*=/, "")
        path = $0
        gsub(/\r/, "", path)
      }
      END { emit() }
    ' "$root/profiles.ini")

    if [[ -n "$entry" ]]; then
      relative=${entry%%|*}
      profile_path=${entry#*|}
      if [[ "$relative" == '1' ]]; then
        candidate="$root/$profile_path"
      else
        candidate=$profile_path
      fi
      if [[ -d "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return
      fi
    fi
  fi

  shopt -s nullglob
  matches=("$root"/*.default-release "$root"/*.default)
  shopt -u nullglob
  for candidate in "${matches[@]}"; do
    if [[ -d "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  die "could not determine the active Firefox profile below $root; use --profile"
}

if [[ -n "$PROFILE_OVERRIDE" ]]; then
  PROFILE_DIR=$PROFILE_OVERRIDE
  [[ -d "$PROFILE_DIR" ]] || die "Firefox profile not found: $PROFILE_DIR"
else
  FIREFOX_ROOT=$(detect_firefox_root)
  PROFILE_DIR=$(detect_profile "$FIREFOX_ROOT")
fi

USER_CHROME="$PROFILE_DIR/chrome/userChrome.css"
USER_JS="$PROFILE_DIR/user.js"
HYPR_MAIN="$HYPR_DIR/hyprland.lua"
HYPR_MODULE="$HYPR_DIR/firefox-top-glass.lua"

backup_file() {
  local target=$1
  local backup="${target}.bak.${TIMESTAMP}"
  local suffix=1

  [[ -e "$target" ]] || return 0
  while [[ -e "$backup" ]]; do
    backup="${target}.bak.${TIMESTAMP}.${suffix}"
    ((suffix += 1))
  done
  cp -p -- "$target" "$backup"
  printf 'backup: %s\n' "$backup"
}

marker_counts() {
  local target=$1
  local begin=$2
  local end=$3
  local begin_count=0
  local end_count=0

  if [[ -f "$target" ]]; then
    begin_count=$(grep -Fxc -- "$begin" "$target" || true)
    end_count=$(grep -Fxc -- "$end" "$target" || true)
  fi
  printf '%s %s\n' "$begin_count" "$end_count"
}

validate_markers() {
  local target=$1
  local begin=$2
  local end=$3
  local counts=''
  local begin_count=0
  local end_count=0

  counts=$(marker_counts "$target" "$begin" "$end")
  read -r begin_count end_count <<<"$counts"
  if ! { [[ "$begin_count" == '0' && "$end_count" == '0' ]] ||
         [[ "$begin_count" == '1' && "$end_count" == '1' ]]; }; then
    die "malformed or duplicate managed block in $target"
  fi
}

strip_block() {
  local target=$1
  local begin=$2
  local end=$3

  if [[ ! -f "$target" ]]; then
    return
  fi

  awk -v begin="$begin" -v end="$end" '
    $0 == begin { inside = 1; next }
    $0 == end { inside = 0; next }
    !inside { lines[++count] = $0 }
    END {
      while (count > 0 && lines[count] ~ /^[[:space:]]*$/) count--
      for (i = 1; i <= count; i++) print lines[i]
    }
  ' "$target"
}

upsert_block() {
  local target=$1
  local begin=$2
  local end=$3
  local asset=$4
  local base_tmp=''
  local output_tmp=''

  validate_markers "$target" "$begin" "$end"
  mkdir -p -- "$(dirname "$target")"
  base_tmp=$(mktemp)
  output_tmp=$(mktemp "${target}.tmp.XXXXXX")
  TMP_PATHS+=("$base_tmp" "$output_tmp")

  strip_block "$target" "$begin" "$end" >"$base_tmp"
  {
    if [[ -s "$base_tmp" ]]; then
      cat "$base_tmp"
      printf '\n'
    fi
    printf '%s\n' "$begin"
    cat "$asset"
    printf '%s\n' "$end"
  } >"$output_tmp"

  if [[ -f "$target" ]] && cmp -s -- "$target" "$output_tmp"; then
    printf 'unchanged: %s\n' "$target"
    return
  fi

  backup_file "$target"
  if [[ -f "$target" ]]; then
    chmod --reference="$target" "$output_tmp"
  else
    chmod 0644 "$output_tmp"
  fi
  mv -f -- "$output_tmp" "$target"
  CHANGED=1
  printf 'updated: %s\n' "$target"
}

remove_block() {
  local target=$1
  local begin=$2
  local end=$3
  local counts=''
  local begin_count=0
  local end_count=0
  local output_tmp=''

  validate_markers "$target" "$begin" "$end"
  counts=$(marker_counts "$target" "$begin" "$end")
  read -r begin_count end_count <<<"$counts"
  if [[ "$begin_count" == '0' ]]; then
    printf 'unchanged: %s\n' "$target"
    return
  fi

  output_tmp=$(mktemp "${target}.tmp.XXXXXX")
  TMP_PATHS+=("$output_tmp")
  strip_block "$target" "$begin" "$end" >"$output_tmp"
  backup_file "$target"
  chmod --reference="$target" "$output_tmp"
  mv -f -- "$output_tmp" "$target"
  CHANGED=1
  printf 'updated: %s\n' "$target"
}

has_block() {
  local target=$1
  local begin=$2
  local end=$3
  local counts=''
  local begin_count=0
  local end_count=0

  counts=$(marker_counts "$target" "$begin" "$end")
  read -r begin_count end_count <<<"$counts"
  [[ "$begin_count" == '1' && "$end_count" == '1' ]]
}

build_chrome_asset() {
  CHROME_ASSET=$(mktemp)
  TMP_PATHS+=("$CHROME_ASSET")
  {
    printf '%s%s */\n' "$THEME_MARKER_PREFIX" "$THEME"
    cat "$THEME_ASSET"
    printf '\n'
    cat "$ASSETS_DIR/userChrome.css"
  } >"$CHROME_ASSET"
}

installed_theme() {
  local marker=''

  [[ -f "$USER_CHROME" ]] || return 0
  marker=$(awk -v begin="$CSS_BEGIN" -v end="$CSS_END" -v prefix="$THEME_MARKER_PREFIX" '
    $0 == begin { inside = 1; next }
    $0 == end { exit }
    inside && index($0, prefix) == 1 { print; exit }
  ' "$USER_CHROME")
  [[ -n "$marker" ]] || return 0
  marker=${marker#"$THEME_MARKER_PREFIX"}
  printf '%s\n' "${marker% */}"
}

reload_hyprland() {
  local errors=''

  ((RELOAD_HYPRLAND == 1)) || return 0
  command -v hyprctl >/dev/null 2>&1 || {
    warn 'hyprctl not found; the blur configuration will apply at the next Hyprland start'
    return
  }

  if ! hyprctl reload >/dev/null 2>&1; then
    warn 'could not reach the live Hyprland session; reload it manually'
    return
  fi

  errors=$(hyprctl configerrors 2>&1 || true)
  if [[ -n "$(printf '%s' "$errors" | tr -d '[:space:]')" ]]; then
    printf '%s\n' "$errors" >&2
    die 'Hyprland reported configuration errors'
  fi
  printf 'Hyprland reloaded with no configuration errors.\n'
}

show_status() {
  local missing=0
  local theme=''
  local spec=''
  local label=''
  local target=''
  local begin=''
  local end=''

  printf 'Firefox profile: %s\n' "$PROFILE_DIR"
  for spec in \
    "Firefox chrome|$USER_CHROME|$CSS_BEGIN|$CSS_END" \
    "Firefox preferences|$USER_JS|$JS_BEGIN|$JS_END" \
    "Hyprland module|$HYPR_MODULE|$LUA_BEGIN|$LUA_END" \
    "Hyprland loader|$HYPR_MAIN|$LUA_BEGIN|$LUA_END"; do
    IFS='|' read -r label target begin end <<<"$spec"
    if has_block "$target" "$begin" "$end"; then
      printf 'installed: %s (%s)\n' "$label" "$target"
    else
      printf 'missing:   %s (%s)\n' "$label" "$target"
      missing=1
    fi
  done
  if has_block "$USER_CHROME" "$CSS_BEGIN" "$CSS_END"; then
    theme=$(installed_theme)
    printf 'Theme: %s\n' "${theme:-legacy/unknown}"
  fi
  return "$missing"
}

case "$ACTION" in
  install)
    [[ -f "$HYPR_MAIN" ]] || die "Omarchy Hyprland config not found: $HYPR_MAIN"
    build_chrome_asset
    upsert_block "$USER_CHROME" "$CSS_BEGIN" "$CSS_END" "$CHROME_ASSET"
    upsert_block "$USER_JS" "$JS_BEGIN" "$JS_END" "$ASSETS_DIR/user.js"
    upsert_block "$HYPR_MODULE" "$LUA_BEGIN" "$LUA_END" "$ASSETS_DIR/firefox-top-glass.lua"
    upsert_block "$HYPR_MAIN" "$LUA_BEGIN" "$LUA_END" "$ASSETS_DIR/hyprland-require.lua"
    reload_hyprland
    if ((CHANGED == 0)); then
      printf 'Firefox Top Glass is already up to date (theme: %s).\n' "$THEME"
    else
      printf 'Installed Firefox Top Glass (theme: %s). Fully close and reopen Firefox once.\n' "$THEME"
    fi
    ;;
  status)
    show_status
    ;;
  remove)
    remove_block "$USER_CHROME" "$CSS_BEGIN" "$CSS_END"
    remove_block "$USER_JS" "$JS_BEGIN" "$JS_END"
    remove_block "$HYPR_MAIN" "$LUA_BEGIN" "$LUA_END"
    remove_block "$HYPR_MODULE" "$LUA_BEGIN" "$LUA_END"
    reload_hyprland
    printf 'Removed managed Firefox Top Glass blocks. Fully close and reopen Firefox once.\n'
    printf 'Firefox may retain preference values in prefs.js; reset them in about:config if needed.\n'
    ;;
esac
